# Platform: "telegram" or "bale" (default: bale)
PLATFORM=bale

# Telegram Bot Token (get from @BotFather) - used when PLATFORM=telegram
BOT_TOKEN=your_bot_token_here

# Bale Bot Token (get from @BotFather in Bale) - used when PLATFORM=bale
BALE_BOT_TOKEN=your_bale_bot_token_here

# API Base URL (default: https://app.agniops.in)
API_BASE_URL=https://app.agniops.in

# API Key (optional - only if the API requires authentication)
# API_KEY=your_api_key_here

# Comma-separated list of allowed user IDs (optional - empty means all users allowed)
# ALLOWED_USER_IDS=123456789,987654321

# Request timeout in seconds (default: 180 = 3 minutes for slow domains)
REQUEST_TIMEOUT=180

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL=600

# Per-user rate limit: minimum seconds between requests (default: 1)
RATE_LIMIT_SECONDS=1

# Proxy URL for Telegram and API connections (optional)
# Examples: socks5://127.0.0.1:1080, http://127.0.0.1:10809, socks5h://user:pass@host:port
# PROXY_URL=